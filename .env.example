# Development only. Use a strong password without semicolons, quotes or dollar signs.
MSSQL_SA_PASSWORD=ChangeMe_Replace_123
# Generate a random secret of at least 32 characters and keep it private.
TASKPILOT_JWT_KEY=
# Set to true to export traces and metrics to the optional local Aspire dashboard.
TASKPILOT_OTEL_ENABLED=false
# Optional SMTP overrides. Local Compose defaults to Mailpit and does not send real mail.
# TASKPILOT_SMTP_HOST=
# TASKPILOT_SMTP_PORT=587
# TASKPILOT_SMTP_USERNAME=
# TASKPILOT_SMTP_PASSWORD=
# TASKPILOT_SMTP_USE_SSL=true
# TASKPILOT_EMAIL_FROM=noreply@example.com
# TASKPILOT_EMAIL_VERIFICATION_BASE_URL=https://taskpilot.example.com/verify-email
# TASKPILOT_MAILPIT_PORT=8025
# Optional: local front-end port (default 5173).
# TASKPILOT_FRONTEND_PORT=5173
# Optional: local observability dashboard port (default 18888).
# TASKPILOT_DASHBOARD_PORT=18888

# Staging only: configure these before starting compose.staging.yaml.
# TASKPILOT_DOMAIN=taskpilot.example.com
# TASKPILOT_STAGING_ALLOWED_CIDR=203.0.113.10/32
# TASKPILOT_CADDY_IP=172.30.0.2
# TASKPILOT_CADDY_SUBNET=172.30.0.0/24
