// TaskPilot.API/appsettings.json
{
  "ConnectionStrings": {
    "TaskPilotDBConnection": ""
  },
  "ExternalServices": {
    // Chave de exemplo para o NotificationService (usada na Infrastructure)
    "NotificationApiKey": "SEGREDO_DA_API_DE_NOTIFICACAO_REAL_AQUI"
  },
  "Logging": {
    "Console": {
      "FormatterName": "json"
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RateLimiting": {
    "Auth": {
      "LoginPermitLimit": 5,
      "RegisterPermitLimit": 3
    }
  },
  "AllowedHosts": "*"
}