@baseUrl = http://localhost:5000
@email = replace-with-your-email
@password = replace-with-your-password
@accessToken = replace-with-your-token
@userId = replace-with-your-user-id
@taskId = replace-with-your-task-id

### Criar conta
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "firstName": "Example",
  "lastName": "User",
  "email": "{{email}}",
  "password": "{{password}}"
}

### Fazer login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Consultar a conta autenticada
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{accessToken}}

### Criar tarefa
POST {{baseUrl}}/api/v1/tasks
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Minha tarefa",
  "dueDate": "2030-12-31T23:59:59.9999999"
}

### Consultar tarefas
GET {{baseUrl}}/api/v1/tasks/summary/{{userId}}
Authorization: Bearer {{accessToken}}

### Concluir tarefa
POST {{baseUrl}}/api/v1/tasks/{{taskId}}/complete
Authorization: Bearer {{accessToken}}

### Editar tarefa
PUT {{baseUrl}}/api/v1/tasks/{{taskId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Minha tarefa atualizada",
  "description": "Descrição opcional",
  "priorityLevel": 2,
  "dueDate": "2031-01-15T23:59:59.9999999"
}

### Remover prazo (omitir dueDate mantém o prazo existente)
PUT {{baseUrl}}/api/v1/tasks/{{taskId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Minha tarefa atualizada",
  "priorityLevel": 2,
  "dueDate": null
}

### Excluir tarefa permanentemente
DELETE {{baseUrl}}/api/v1/tasks/{{taskId}}
Authorization: Bearer {{accessToken}}
